<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/Astyle.css">
    <title>E-mpanera</title>
</head>
<body>
    <header>
        <h1> Administrateur </h1>
    </header>
    <main>
        <div class="leftside">
            <h1 style="text-align: center;"> Formulaire d'ajout </h1> <hr>
            <form action="/Add" method="POST" >
                <div class="form">
                <label for="Loyer"> Lieu : </label><input type="text" name="Lieu">
                <label for="Type"> Type du maison : </label><input type="text" name="Type">
                <label for="Dimension"> Dimension : </label><input type="text" name="Dimension">
                <label for="Electricité"> Electricité : </label><input type="text" name="Electricité">
                <label for="Eau"> Eau : </label><input type="text" name="Eau">
                <label for="Loyer"> Loyer : </label><input type="text" name="Loyer">
                <label for="Contact"> Contact : </label><input type="text" name="Contact">
                <button type="submit" id="Ajout">Ajouter</button>
            </div>
            </form>
        </div>
        <div class="rightside">
            <div class="list-container">
                <% items.forEach(function(item) { %>
                    <ul>
                        <li><%= item.lieu %></li>
                        <li><%= item.loyer %></li>
                        <li><%= item.contact %></li>
                        <li>
                            <form action="/delete/<%= item.id %>" method="post">
                                <button type="submit"> Supprimer </button>
                            </form>

                            <a href="/edit/<%= item.id %>">Modifier</a>
                            <!-- <input type="button" value="Modifier">  --> 
                        </li>
                    </ul>
                    
                    <hr>
                <% }) %>
            </div>
        </div>
    </main>
    <footer>
        <a href="/logout" id="red">Se déconnecter</a>
    </footer>
</body>
<script>



</script>
</html>